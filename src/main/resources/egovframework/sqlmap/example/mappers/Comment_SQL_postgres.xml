<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="commentDAO">


    <resultMap id="commentResult"
               type="egovframework.example.comment.service.CommentVO">

        <result property="biIdx"
                column="bi_idx"/>

        <result property="uiIdx"
                column="ui_idx"/>

        <result property="uiName"
                column="ui_name"/>

        <result property="biType"
                column="bi_type"/>

        <result property="biContent"
                column="bi_content"/>

        <result property="biRefidx"
                column="bi_refidx"/>

        <result property="timeCreated"
                column="time_created"/>

        <result property="timeModified"
                column="time_modified"/>

    </resultMap>


    <!-- 댓글 목록 -->
    <select id="selectCommentList"
            parameterType="egovframework.example.comment.service.CommentVO"
            resultMap="commentResult">

        SELECT
            b.bi_idx,
            b.ui_idx,
            u.ui_name,
            b.bi_type,
            b.bi_content,
            b.bi_refidx,
            b.time_created,
            b.time_modified

        FROM board_info b

        INNER JOIN user_info u
            ON b.ui_idx = u.ui_idx

        WHERE b.bi_type = 2
          AND b.bi_refidx = #{biRefidx}

        ORDER BY b.bi_idx ASC

    </select>


    <!-- 댓글 등록 -->
    <insert id="insertComment"
            parameterType="egovframework.example.comment.service.CommentVO">

        INSERT INTO board_info
        (
            ui_idx,
            bi_type,
            bi_title,
            bi_content,
            bi_filename,
            bi_filepath,
            bi_refidx,
            time_created,
            time_modified
        )

        VALUES
        (
            #{uiIdx},
            2,
            NULL,
            #{biContent},
            NULL,
            NULL,
            #{biRefidx},
            CURRENT_TIMESTAMP,
            CURRENT_TIMESTAMP
        )

    </insert>


    <!-- 본인 댓글 수정 -->
    <update id="updateComment"
            parameterType="egovframework.example.comment.service.CommentVO">

        UPDATE board_info

        SET
            bi_content = #{biContent},
            time_modified = CURRENT_TIMESTAMP

        WHERE bi_idx = #{biIdx}
          AND ui_idx = #{uiIdx}
          AND bi_type = 2

    </update>


</mapper>