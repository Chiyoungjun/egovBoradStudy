<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans-4.0.xsd">

    <!-- SqlSession setup for MyBatis Database Layer -->
    <bean id="sqlSession"
          class="org.mybatis.spring.SqlSessionFactoryBean">

        <property name="dataSource"
                  ref="dataSource" />

        <property name="configLocation"
                  value="classpath:/egovframework/sqlmap/example/sql-mapper-config.xml" />

        <!-- sample / user / board XML을 모두 같은 폴더에서 조회 -->
        <property name="mapperLocations"
                  value="classpath:/egovframework/sqlmap/example/mappers/*.xml" />

    </bean>


    <!-- Mapper Interface 스캔 -->
    <bean class="org.egovframe.rte.psl.dataaccess.mapper.MapperConfigurer">

    <property name="basePackage"
              value="egovframework.example.sample.service.impl" />

	</bean>

</beans>